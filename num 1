import java.util.Scanner;

public class RegistroUsuarios {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        // Arrays para almacenar datos de 5 usuarios
        String[] nombres = new String[5];
        int[] edades = new int[5];
        String[] estados = new String[5];

        // Solicitar datos para cada usuario
        for (int i = 0; i < 5; i++) {
            System.out.println("\nIngrese los datos del usuario " + (i + 1) + ":");
            
            System.out.print("Nombre: ");
            nombres[i] = scanner.nextLine();
            
            System.out.print("Edad: ");
            edades[i] = Integer.parseInt(scanner.nextLine());
            
            System.out.print("Estado (Activo/Inactivo): ");
            estados[i] = scanner.nextLine();
        }

        // Mostrar información de usuarios
        System.out.println("\nResultados:");
        for (int i = 0; i < nombres.length; i++) {
            System.out.println("Estado del usuario " + nombres[i] + ": " + estados[i] + ";");
            
            if (edades[i] >= 18) {
                System.out.println("Usuario " + nombres[i] + " es mayor de edad;");
            } else {
                System.out.println("Usuario " + nombres[i] + " es menor de edad;");
            }
            System.out.println(); // Línea en blanco para separar usuarios
        }
        
        scanner.close();
    }
}
